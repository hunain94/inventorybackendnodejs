generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tblcategories {
  category_id  Int           @id @default(autoincrement())
  fk_userid    Int?
  categoryname String        @unique @db.VarChar(400)
  isactive     String        @db.Bit(1)
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  modified_at  DateTime?     @default(now()) @db.Timestamp(6)
  tblusers     tblusers?     @relation(fields: [fk_userid], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tblproducts  tblproducts[]
}

model tblconfigurationmanager {
  key_id      Int       @id @default(autoincrement())
  key_name    String    @unique @db.VarChar(300)
  value       String    @db.VarChar(300)
  isactive    String    @db.Bit(1)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  modified_at DateTime? @default(now()) @db.Timestamp(6)
}

model tblproducts {
  product_id    Int            @id @default(autoincrement())
  fk_categoryid Int?
  fk_userid     Int?
  product_name  String         @db.VarChar(300)
  quantity      Int
  amount        Int
  isactive      String         @db.Bit(1)
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  modified_at   DateTime?      @default(now()) @db.Timestamp(6)
  remarks       String?        @db.VarChar(300)
  tblcategories tblcategories? @relation(fields: [fk_categoryid], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  tblusers      tblusers?      @relation(fields: [fk_userid], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model tblproductslogs {
  product_id    Int       @id @default(autoincrement())
  fk_categoryid Int
  fk_userid     Int
  product_name  String    @db.VarChar(300)
  quantity      Int
  amount        Int
  isactive      String    @db.Bit(1)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  modified_at   DateTime? @default(now()) @db.Timestamp(6)
  remarks       String?   @db.VarChar(300)
}

model tblroles {
  role_id    Int        @id @default(autoincrement())
  role_name  String     @unique @db.VarChar(100)
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  tblusers   tblusers[]
}

model tblusers {
  user_id       Int             @id @default(autoincrement())
  username      String          @unique @db.VarChar(255)
  email         String          @unique @db.VarChar(400)
  password      String          @db.VarChar(1000)
  isactive      String          @db.Bit(1)
  role_id       Int?
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  modified_at   DateTime?       @default(now()) @db.Timestamp(6)
  tblcategories tblcategories[]
  tblproducts   tblproducts[]
  tblroles      tblroles?       @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
}
